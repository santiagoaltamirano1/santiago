# Lumi Finance · Variables del SERVIDOR (en AI Studio van en el panel "Secrets"; nunca en el código)
# GEMINI_API_KEY la pone AI Studio sola.
GEMINI_API_KEY=
# Opcional: modelo de Gemini para la voz (por defecto gemini-2.5-flash)
GEMINI_MODELO=
# Solo si /api/salud dice que Firestore no tiene permiso: JSON completo de una cuenta de servicio de Firebase
FIREBASE_SERVICE_ACCOUNT=
# Solo para medir la voz (muestra "Medir la voz" en Analítica › Ajustes). Quitar al terminar.
EVAL_VOZ=
