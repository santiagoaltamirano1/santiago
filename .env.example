# Lumi Finance · Variables del SERVIDOR (en AI Studio van en el panel "Secrets"; nunca en el código)
# GEMINI_API_KEY la pone AI Studio sola.
GEMINI_API_KEY=
# Opcional: modelo de Gemini para la voz (por defecto gemini-2.5-flash)
GEMINI_MODELO=gemini-2.5-flash
# Solo si /api/salud dice que Firestore no tiene permiso: JSON completo de una cuenta de servicio. Si no, "no".
FIREBASE_SERVICE_ACCOUNT=no
# 1 = muestra "Medir la voz" en Analítica › Ajustes (gasta saldo). 0 = apagado.
EVAL_VOZ=0
